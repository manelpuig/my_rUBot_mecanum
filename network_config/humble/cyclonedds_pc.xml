<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>

      <!-- Fixem explícitament la IP del PC -->
      <Interfaces>
        <NetworkInterface address="192.168.1.16"/>
      </Interfaces>

      <!-- Com que utilitzes ROS_AUTOMATIC_DISCOVERY_RANGE=OFF
           i ROS_STATIC_PEERS, és millor desactivar multicast -->
      <AllowMulticast>false</AllowMulticast>

    </General>

    <!-- Opcional però recomanat en robòtica (imatges, pointclouds) -->
    <Internal>
      <SocketReceiveBufferSize min="10MB"/>
      <SocketSendBufferSize min="10MB"/>
    </Internal>

  </Domain>
</CycloneDDS>
