<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_robot_cartographer</name>
  <version>0.1.0</version>
  <description>Cartographer launch and configuration for my_robot (ROS 2 Jazzy).</description>

  <maintainer email="manel.puig@ub.edu">Manel Puig</maintainer>
  <license>Apache-2.0</license>

  <url type="repository">https://github.com/manelpuig/my_rUBot_mecanum</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Nodes launched by this package -->
  <exec_depend>cartographer_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Python imports used in launch files -->
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
