<?xml version="1.0" ?>
<sdf version="1.10">
    <model name="rubot_differential">
        <static>false</static>

        <!-- Pose inicial -->
        <pose>0 0 0 0 0 0</pose>

        <!-- Base -->
        <link name="base_link">
        <pose>0 0 0.10 0 0 0</pose>
        <inertial>
            <mass>5.0</mass>
            <inertia>
            <ixx>0.10</ixx><iyy>0.10</iyy><izz>0.10</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
            </inertia>
        </inertial>

        <collision name="base_collision">
            <geometry>
            <box><size>0.35 0.25 0.10</size></box>
            </geometry>
        </collision>

        <visual name="base_visual">
            <geometry>
            <box><size>0.35 0.25 0.10</size></box>
            </geometry>
            <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
            </material>
        </visual>
        </link>

        <!-- =========================
            Wheels geometry (shared intent)
            - Cylinder axis is Z by default, so rotate with roll=1.57 to look like a wheel
            - Symmetric wheel placement: X = ±0.15, Y = ±0.13
            ========================= -->

        <!-- Upper left (front-left) -->
        <link name="upper_left_wheel">
        <pose>0.10 0.13 0.05 1.57 0 0</pose>
        <inertial>
            <mass>0.5</mass>
            <inertia>
            <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
            </inertia>
        </inertial>
        <collision name="upper_left_wheel_collision">
            <geometry>
            <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
            </geometry>
            <surface>
            <friction>
                <ode>
                <mu>2.0</mu><mu2>2.0</mu2>
                </ode>
            </friction>
            </surface>
        </collision>
        <visual name="upper_left_wheel_visual">
            <geometry>
            <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
            </geometry>
        </visual>
        </link>

        <joint name="upper_left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>upper_left_wheel</child>
        <axis>
            <xyz>0 0 -1</xyz>
            <limit>
            <lower>-1e16</lower><upper>1e16</upper>
            <effort>50</effort><velocity>100</velocity>
            </limit>
        </axis>
        </joint>

        <!-- Upper right (front-right) -->
        <link name="upper_right_wheel">
        <pose>0.10 -0.13 0.05 1.57 0 0</pose>
        <inertial>
            <mass>0.5</mass>
            <inertia>
            <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
            </inertia>
        </inertial>
        <collision name="upper_right_wheel_collision">
            <geometry>
            <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
            </geometry>
            <surface>
            <friction>
                <ode>
                <mu>2.0</mu><mu2>2.0</mu2>
                </ode>
            </friction>
            </surface>
        </collision>
        <visual name="upper_right_wheel_visual">
            <geometry>
            <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
            </geometry>
        </visual>
        </link>

        <joint name="upper_right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>upper_right_wheel</child>
        <axis>
            <xyz>0 0 -1</xyz>
            <limit>
            <lower>-1e16</lower><upper>1e16</upper>
            <effort>50</effort><velocity>100</velocity>
            </limit>
        </axis>
        </joint>

        <!-- Lower left (rear-left) -->
        <link name="lower_left_wheel">
        <pose>-0.10 0.13 0.05 1.57 0 0</pose>
        <inertial>
            <mass>0.5</mass>
            <inertia>
            <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
            </inertia>
        </inertial>
        <collision name="lower_left_wheel_collision">
            <geometry>
            <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
            </geometry>
            <surface>
            <friction>
                <ode>
                <mu>0.2</mu><mu2>0.2</mu2>
                </ode>
            </friction>
            </surface>
        </collision>
        <visual name="lower_left_wheel_visual">
            <geometry>
            <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
            </geometry>
        </visual>
        </link>

        <joint name="lower_left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>lower_left_wheel</child>
        <axis>
            <xyz>0 0 -1</xyz>
            <limit>
            <lower>-1e16</lower><upper>1e16</upper>
            <effort>50</effort><velocity>100</velocity>
            </limit>
        </axis>
        </joint>

        <!-- Lower right (rear-right) -->
        <link name="lower_right_wheel">
        <pose>-0.10 -0.13 0.05 1.57 0 0</pose>
        <inertial>
            <mass>0.5</mass>
            <inertia>
            <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
            </inertia>
        </inertial>
        <collision name="lower_right_wheel_collision">
            <geometry>
            <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
            </geometry>
            <surface>
            <friction>
                <ode>
                <mu>0.2</mu><mu2>0.2</mu2>
                </ode>
            </friction>
            </surface>
        </collision>
        <visual name="lower_right_wheel_visual">
            <geometry>
            <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
            </geometry>
        </visual>
        </link>

        <joint name="lower_right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>lower_right_wheel</child>
        <axis>
            <xyz>0 0 -1</xyz>
            <limit>
            <lower>-1e16</lower><upper>1e16</upper>
            <effort>50</effort><velocity>100</velocity>
            </limit>
        </axis>
        </joint>

        <!-- =========================
            Lidar (centered on base CG)
            ========================= -->
        <link name="base_scan">
        <!-- centered on base_link, above CG -->
        <pose relative_to="base_link">0 0 0.14 0 0 0</pose>

        <visual name="lidar_visual">
            <geometry>
            <cylinder><radius>0.05</radius><length>0.05</length></cylinder>
            </geometry>
            <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            </material>
        </visual>

        <sensor name="lidar" type="gpu_lidar">
            <always_on>true</always_on>
            <update_rate>10</update_rate>
            <topic>/scan</topic>

            <pose>0 0 0 0 0 0</pose>

            <lidar>
            <scan>
                <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
                </horizontal>
            </scan>

            <range>
                <min>0.12</min>
                <max>10.0</max>
                <resolution>0.01</resolution>
            </range>

            <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.0</stddev>
            </noise>
            </lidar>
        </sensor>
        </link>

        <joint name="base_scan_joint" type="fixed">
        <parent>base_link</parent>
        <child>base_scan</child>
        </joint>

        <!-- =========================
            Camera (front-mounted)
            ========================= -->
        <link name="camera_link">
        <!-- front of base_link; rotate so camera looks forward (along +X) -->
        <pose relative_to="base_link">0.15 0 0.06 0 0 0</pose>

        <visual name="camera_visual">
            <geometry>
            <box><size>0.02 0.05 0.03</size></box>
            </geometry>
            <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
            </material>
        </visual>

        <sensor name="camera" type="camera">
            <always_on>true</always_on>
            <update_rate>30</update_rate>

            <camera>
            <horizontal_fov>1.3962634</horizontal_fov>
            <image>
                <width>640</width>
                <height>480</height>
                <format>R8G8B8</format>
            </image>
            <clip>
                <near>0.05</near>
                <far>50</far>
            </clip>
            </camera>

            <!-- In Gazebo this will publish images on /camera and info on /camera_info -->
            <topic>/camera</topic>
        </sensor>
        </link>

        <joint name="camera_joint" type="fixed">
        <parent>base_link</parent>
        <child>camera_link</child>
        </joint>

        <!-- Plugin DiffDrive: tracció a les rodes de davant (upper_*) -->
        <plugin name="gz::sim::systems::DiffDrive" filename="gz-sim-diff-drive-system">
        <left_joint>upper_left_wheel_joint</left_joint>
        <right_joint>upper_right_wheel_joint</right_joint>
        <wheel_separation>0.26</wheel_separation>
        <wheel_radius>0.05</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        </plugin>

        <!-- Mecanum drive 
        <plugin name="gz::sim::systems::MecanumDrive"
                filename="gz-sim-mecanum-drive-system">
        <topic>/cmd_vel</topic>
        <front_left_joint>upper_left_wheel_joint</front_left_joint>
        <front_right_joint>upper_right_wheel_joint</front_right_joint>
        <back_left_joint>lower_left_wheel_joint</back_left_joint>
        <back_right_joint>lower_right_wheel_joint</back_right_joint>
        <wheelbase>0.20</wheelbase>
        <wheel_separation>0.26</wheel_separation>
        <wheel_radius>0.055</wheel_radius>
        <odom_topic>/odom</odom_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        </plugin> -->
    </model>
</sdf>
