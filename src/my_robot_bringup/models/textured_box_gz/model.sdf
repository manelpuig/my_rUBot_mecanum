<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="textured_box">
    <static>true</static>

    <link name="link">
        <collision name="collision">
            <geometry>
            <box><size>1 1 1</size></box>
            </geometry>
        </collision>
        <visual name="textured_box">
            <geometry>
                <box>
                <size>1 1 1</size>
                </box>
            </geometry>
            <material>
                <pbr>
                <metal>
                    <albedo>1 1 1 1</albedo>
                    <albedo_map>model://textured_box/materials/textures/no_right_turn.png</albedo_map>
                    <!-- Per fer-la sempre visible -->
                    <emissive>0.3 0.3 0.3 1</emissive>
                    <emissive_map>model://textured_box/materials/textures/no_right_turn.png</emissive_map>
                </metal>
                </pbr>
            </material>
            <cast_shadows>false</cast_shadows>
        </visual>

    </link>
  </model>
</sdf>