<?xml version="1.0"?>
<sdf version="1.7">
  <model name="wall90cm">
    <static>true</static>

    <pose>0 0 0 0 0 0</pose>

    <link name="link">
      <collision name="collision">
        <geometry>
          <box>
            <size>0.9 0.05 0.3</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.9 0.05 0.3</size>
          </box>
        </geometry>

        <!-- Material portable (Ignition + gz-sim) -->
        <material>
          <!-- “wood-ish” simple -->
          <ambient>0.45 0.30 0.15 1</ambient>
          <diffuse>0.45 0.30 0.15 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>

