<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
    Reusable Xacro macro for the 6-servo SG90 aluminium arm.

    Intended use:
      - Included from the complete rUBot mecanum robot description.
      - Mounted on an existing parent link, normally base_link.
      - Joint and link names are prefixed, normally with "arm_".
      - joint6 is revolute because the real gripper actuator is an angular servo.

    Kinematic approximation:
      joint1: base yaw
      joint2: shoulder pitch
      joint3: elbow pitch
      joint4: wrist pitch
      joint5: wrist roll
      joint6: gripper open-close servo
  -->

  <!-- ================================================================ -->
  <!-- Reusable helper macros                                            -->
  <!-- ================================================================ -->

  <xacro:macro name="arm_inertial_box" params="mass x y z ox:=0 oy:=0 oz:=0">
    <inertial>
      <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x*x + z*z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro
    name="arm_box_visual_collision"
    params="name x y z ox oy oz material">

    <visual name="${name}_visual">
      <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
      <geometry>
        <box size="${x} ${y} ${z}"/>
      </geometry>
      <material name="${material}"/>
    </visual>

    <collision name="${name}_collision">
      <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
      <geometry>
        <box size="${x} ${y} ${z}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <!-- ================================================================ -->
  <!-- Arm macro                                                         -->
  <!-- ================================================================ -->

  <xacro:macro
    name="my_arm_mecanum_5dof"
    params="
      prefix
      parent
      xyz:='0 0 0'
      rpy:='0 0 0'
      hardware_plugin:='fake_components/GenericSystem'
    ">

    <!-- Main dimensions -->
    <xacro:property name="base_x" value="0.090"/>
    <xacro:property name="base_y" value="0.084"/>
    <xacro:property name="base_z" value="0.012"/>

    <xacro:property name="L1" value="0.105"/>
    <xacro:property name="L2" value="0.135"/>
    <xacro:property name="L3" value="0.125"/>
    <xacro:property name="L4" value="0.045"/>
    <xacro:property name="tool_x" value="0.055"/>

    <!-- Visual dimensions -->
    <xacro:property name="servo_x" value="0.040"/>
    <xacro:property name="servo_y" value="0.020"/>
    <xacro:property name="servo_z" value="0.038"/>
    <xacro:property name="plate_t" value="0.004"/>
    <xacro:property name="link_w" value="0.020"/>
    <xacro:property name="finger_l" value="0.060"/>

    <!-- Mount the arm on the robot -->
    <joint name="${prefix}mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- ============================================================== -->
    <!-- Links                                                          -->
    <!-- ============================================================== -->

    <link name="${prefix}base_link">
      <xacro:arm_box_visual_collision
        name="${prefix}base_plate"
        x="${base_x}"
        y="${base_y}"
        z="${base_z}"
        ox="0"
        oy="0"
        oz="${base_z / 2.0}"
        material="black"/>

      <visual name="${prefix}base_servo_visual">
        <origin xyz="0 0 ${base_z + servo_z / 2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${servo_x} ${servo_y} ${servo_z}"/>
        </geometry>
        <material name="servo"/>
      </visual>

      <collision name="${prefix}base_servo_collision">
        <origin xyz="0 0 ${base_z + servo_z / 2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${servo_x} ${servo_y} ${servo_z}"/>
        </geometry>
      </collision>

      <xacro:arm_inertial_box
        mass="0.18"
        x="${base_x}"
        y="${base_y}"
        z="${base_z}"
        ox="0"
        oy="0"
        oz="${base_z / 2.0}"/>
    </link>

    <link name="${prefix}link1">
      <xacro:arm_box_visual_collision
        name="${prefix}vertical_bracket"
        x="${link_w}"
        y="${plate_t}"
        z="${L1}"
        ox="0"
        oy="0"
        oz="${L1 / 2.0}"
        material="metal"/>

      <visual name="${prefix}shoulder_servo_visual">
        <origin xyz="0 0 ${L1}" rpy="0 0 0"/>
        <geometry>
          <box size="${servo_y} ${servo_x} ${servo_z}"/>
        </geometry>
        <material name="servo"/>
      </visual>

      <collision name="${prefix}shoulder_servo_collision">
        <origin xyz="0 0 ${L1}" rpy="0 0 0"/>
        <geometry>
          <box size="${servo_y} ${servo_x} ${servo_z}"/>
        </geometry>
      </collision>

      <xacro:arm_inertial_box
        mass="0.08"
        x="${link_w}"
        y="${plate_t}"
        z="${L1}"
        ox="0"
        oy="0"
        oz="${L1 / 2.0}"/>
    </link>

    <link name="${prefix}link2">
      <xacro:arm_box_visual_collision
        name="${prefix}upper_left_plate"
        x="${L2}"
        y="${plate_t}"
        z="${link_w}"
        ox="${L2 / 2.0}"
        oy="0.014"
        oz="0"
        material="dark_grey"/>

      <xacro:arm_box_visual_collision
        name="${prefix}upper_right_plate"
        x="${L2}"
        y="${plate_t}"
        z="${link_w}"
        ox="${L2 / 2.0}"
        oy="-0.014"
        oz="0"
        material="dark_grey"/>

      <visual name="${prefix}elbow_servo_visual">
        <origin xyz="${L2} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${servo_y} ${servo_x} ${servo_z}"/>
        </geometry>
        <material name="servo"/>
      </visual>

      <collision name="${prefix}elbow_servo_collision">
        <origin xyz="${L2} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${servo_y} ${servo_x} ${servo_z}"/>
        </geometry>
      </collision>

      <xacro:arm_inertial_box
        mass="0.09"
        x="${L2}"
        y="0.032"
        z="${link_w}"
        ox="${L2 / 2.0}"
        oy="0"
        oz="0"/>
    </link>

    <link name="${prefix}link3">
      <xacro:arm_box_visual_collision
        name="${prefix}forearm_left_plate"
        x="${L3}"
        y="${plate_t}"
        z="${link_w}"
        ox="${L3 / 2.0}"
        oy="0.014"
        oz="0"
        material="dark_grey"/>

      <xacro:arm_box_visual_collision
        name="${prefix}forearm_right_plate"
        x="${L3}"
        y="${plate_t}"
        z="${link_w}"
        ox="${L3 / 2.0}"
        oy="-0.014"
        oz="0"
        material="dark_grey"/>

      <visual name="${prefix}wrist_pitch_servo_visual">
        <origin xyz="${L3} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${servo_y} ${servo_x} ${servo_z}"/>
        </geometry>
        <material name="servo"/>
      </visual>

      <collision name="${prefix}wrist_pitch_servo_collision">
        <origin xyz="${L3} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${servo_y} ${servo_x} ${servo_z}"/>
        </geometry>
      </collision>

      <xacro:arm_inertial_box
        mass="0.08"
        x="${L3}"
        y="0.032"
        z="${link_w}"
        ox="${L3 / 2.0}"
        oy="0"
        oz="0"/>
    </link>

    <link name="${prefix}link4">
      <xacro:arm_box_visual_collision
        name="${prefix}wrist_support"
        x="${L4}"
        y="${link_w}"
        z="${plate_t}"
        ox="${L4 / 2.0}"
        oy="0"
        oz="0"
        material="metal"/>

      <visual name="${prefix}wrist_roll_servo_visual">
        <origin xyz="${L4} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${servo_z} ${servo_y} ${servo_x}"/>
        </geometry>
        <material name="servo"/>
      </visual>

      <collision name="${prefix}wrist_roll_servo_collision">
        <origin xyz="${L4} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${servo_z} ${servo_y} ${servo_x}"/>
        </geometry>
      </collision>

      <xacro:arm_inertial_box
        mass="0.05"
        x="${L4}"
        y="${link_w}"
        z="${plate_t}"
        ox="${L4 / 2.0}"
        oy="0"
        oz="0"/>
    </link>

    <link name="${prefix}link5">
      <xacro:arm_box_visual_collision
        name="${prefix}gripper_palm"
        x="0.035"
        y="0.035"
        z="0.020"
        ox="0.0175"
        oy="0"
        oz="0"
        material="black"/>

      <xacro:arm_inertial_box
        mass="0.04"
        x="0.035"
        y="0.035"
        z="0.020"
        ox="0.0175"
        oy="0"
        oz="0"/>
    </link>

    <!-- Moving gripper finger -->
    <link name="${prefix}link6">
      <visual name="${prefix}left_finger_visual">
        <origin xyz="${finger_l / 2.0} 0.018 0" rpy="0 0 0"/>
        <geometry>
          <box size="${finger_l} 0.008 0.012"/>
        </geometry>
        <material name="metal"/>
      </visual>

      <collision name="${prefix}left_finger_collision">
        <origin xyz="${finger_l / 2.0} 0.018 0" rpy="0 0 0"/>
        <geometry>
          <box size="${finger_l} 0.008 0.012"/>
        </geometry>
      </collision>

      <xacro:arm_inertial_box
        mass="0.01"
        x="${finger_l}"
        y="0.008"
        z="0.012"
        ox="${finger_l / 2.0}"
        oy="0.018"
        oz="0"/>
    </link>

    <!-- Fixed gripper finger -->
    <link name="${prefix}link6_right">
      <visual name="${prefix}right_finger_visual">
        <origin xyz="${finger_l / 2.0} -0.018 0" rpy="0 0 0"/>
        <geometry>
          <box size="${finger_l} 0.008 0.012"/>
        </geometry>
        <material name="metal"/>
      </visual>

      <collision name="${prefix}right_finger_collision">
        <origin xyz="${finger_l / 2.0} -0.018 0" rpy="0 0 0"/>
        <geometry>
          <box size="${finger_l} 0.008 0.012"/>
        </geometry>
      </collision>

      <xacro:arm_inertial_box
        mass="0.01"
        x="${finger_l}"
        y="0.008"
        z="0.012"
        ox="${finger_l / 2.0}"
        oy="-0.018"
        oz="0"/>
    </link>

    <!-- TCP frame -->
    <link name="${prefix}tool">
      <visual>
        <geometry>
          <sphere radius="0.006"/>
        </geometry>
        <material name="red"/>
      </visual>

      <collision>
        <geometry>
          <sphere radius="0.006"/>
        </geometry>
      </collision>

      <xacro:arm_inertial_box
        mass="0.001"
        x="0.006"
        y="0.006"
        z="0.006"/>
    </link>

    <!-- ============================================================== -->
    <!-- Joints                                                         -->
    <!-- ============================================================== -->

    <joint name="${prefix}joint1" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link1"/>
      <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
    </joint>

    <joint name="${prefix}joint2" type="revolute">
      <parent link="${prefix}link1"/>
      <child link="${prefix}link2"/>
      <origin xyz="0 0 ${L1}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
    </joint>

    <joint name="${prefix}joint3" type="revolute">
      <parent link="${prefix}link2"/>
      <child link="${prefix}link3"/>
      <origin xyz="${L2} 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
    </joint>

    <joint name="${prefix}joint4" type="revolute">
      <parent link="${prefix}link3"/>
      <child link="${prefix}link4"/>
      <origin xyz="${L3} 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
    </joint>

    <joint name="${prefix}joint5" type="revolute">
      <parent link="${prefix}link4"/>
      <child link="${prefix}link5"/>
      <origin xyz="${L4} 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
    </joint>

    <!-- Angular gripper servo -->
    <joint name="${prefix}joint6" type="revolute">
      <parent link="${prefix}link5"/>
      <child link="${prefix}link6"/>
      <origin xyz="0.035 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="0.0" upper="0.7854" effort="0.5" velocity="1.0"/>
    </joint>

    <joint name="${prefix}joint6_right" type="fixed">
      <parent link="${prefix}link5"/>
      <child link="${prefix}link6_right"/>
      <origin xyz="0.035 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="${prefix}link5_to_tool" type="fixed">
      <parent link="${prefix}link5"/>
      <child link="${prefix}tool"/>
      <origin xyz="${tool_x} 0 0" rpy="0 0 0"/>
    </joint>

    <!-- ============================================================== -->
    <!-- ros2_control                                                   -->
    <!-- ============================================================== -->

    <ros2_control name="${prefix}MecanumArmSystem" type="system">
      <hardware>
        <plugin>${hardware_plugin}</plugin>
        <param name="position_proportional_gain">0.1</param>
      </hardware>

      <joint name="${prefix}joint1">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint2">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint3">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint4">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint5">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint6">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>
