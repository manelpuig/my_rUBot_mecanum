<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="rubot_mecanum">

    <!-- Pose: centre del base_link a wheel_radius per tocar terra -->
    <pose>0 0 0.105 0 0 0</pose>
    <static>false</static>

    <!-- =========================
         Base
         ========================= -->
    <link name="base_link">
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.0104</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.0292</iyy> <iyz>0</iyz>
          <izz>0.0375</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box><size>0.23 0.12 0.10</size></box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box><size>0.23 0.12 0.10</size></box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.0 1</ambient>
          <diffuse>0.8 0.8 0.0 1</diffuse>
        </material>
      </visual>

      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>/imu</topic>
      </sensor>

    </link>

    <!-- =========================
         Wheels
         IMPORTANT:
         - Pose on LINK (not on joint)
         - Cylinder rotated so it looks like a wheel
         ========================= -->

    <!-- Upper left -->
    <link name="upper_left_wheel">
      <pose relative_to="base_link">0.07 0.105 -0.05 0 0 0</pose>

      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000166</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.000303</iyy> <iyz>0</iyz>
          <izz>0.000166</izz>
        </inertia>
      </inertial>

      <collision name="c">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.03</length></cylinder></geometry>
        <surface>
          <friction>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </friction>
        </surface>
      </collision>
      <visual name="v">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.03</length></cylinder></geometry>
        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="upper_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>upper_left_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.1</damping>
          <friction>0.1</friction>
        </dynamics>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- Lower left -->
    <link name="lower_left_wheel">
      <pose relative_to="base_link">-0.085 0.105 -0.05 0 0 0</pose>

      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000166</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.000303</iyy> <iyz>0</iyz>
          <izz>0.000166</izz>
        </inertia>
      </inertial>

      <collision name="c">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.03</length></cylinder></geometry>
        <surface>
          <friction>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </friction>
        </surface>
      </collision>
      <visual name="v">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.03</length></cylinder></geometry>
        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="lower_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>lower_left_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.1</damping>
          <friction>0.1</friction>
        </dynamics>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- Upper right -->
    <link name="upper_right_wheel">
      <pose relative_to="base_link">0.07 -0.105 -0.05 0 0 0</pose>

      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000166</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.000303</iyy> <iyz>0</iyz>
          <izz>0.000166</izz>
        </inertia>
      </inertial>

      <collision name="c">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.03</length></cylinder></geometry>
        <surface>
          <friction>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </friction>
        </surface>
      </collision>
      <visual name="v">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.03</length></cylinder></geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.55 0.55 0.55 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="upper_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>upper_right_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.1</damping>
          <friction>0.1</friction>
        </dynamics>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- Lower right -->
    <link name="lower_right_wheel">
      <pose relative_to="base_link">-0.085 -0.105 -0.05 0 0 0</pose>

      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000166</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.000303</iyy> <iyz>0</iyz>
          <izz>0.000166</izz>
        </inertia>
      </inertial>

      <collision name="c">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.03</length></cylinder></geometry>
        <surface>
          <friction>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </friction>
        </surface>
      </collision>
      <visual name="v">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.03</length></cylinder></geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.55 0.55 0.55 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="lower_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>lower_right_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.1</damping>
          <friction>0.1</friction>
        </dynamics>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- =========================
         Lidar
         ========================= -->
    <link name="base_scan">
      <pose relative_to="base_link">0 0 0.14 0 0 0</pose>

      <visual name="lidar_vis">
        <geometry><cylinder><radius>0.05</radius><length>0.05</length></cylinder></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/scan</topic>

        <pose>0 0 0 0 0 0</pose>

        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle> 3.14159</max_angle>
            </horizontal>
          </scan>

          <range>
            <!-- CRÍTIC: min > 0 -->
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>

          <!-- IMPORTANT per evitar coses rares -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.0</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name="scan_joint" type="fixed">
      <parent>base_link</parent>
      <child>base_scan</child>
    </joint>

    <!-- =========================
         Camera
         ========================= -->
    <link name="camera_link">
      <pose relative_to="base_link">0.130 0.0 0.05 0 1.57079632679 0</pose>

      <visual name="lidar_vis">
        <geometry><box><size>0.05 0.05 0.025</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
        </camera>

        <!-- This will produce /camera/image and /camera/camera_info in gz -->
        <topic>/camera</topic>
      </sensor>
    </link>
    <joint name="joint_camera" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- =========================
         Systems
         ========================= -->

    <!-- Mecanum: make topic match the bridge EXACTLY -->
    <plugin filename="libgz-sim8-mecanum-drive-system.so" name="gz::sim::systems::MecanumDrive">
      <topic>/cmd_vel</topic>

      <front_left_joint>upper_left_wheel_joint</front_left_joint>
      <front_right_joint>upper_right_wheel_joint</front_right_joint>
      <rear_left_joint>lower_left_wheel_joint</rear_left_joint>
      <rear_right_joint>lower_right_wheel_joint</rear_right_joint>

      <wheel_radius>0.055</wheel_radius>
      <wheel_separation_width>0.21</wheel_separation_width>
      <wheel_separation_length>0.155</wheel_separation_length>
      <!-- ajuda a veure moviment a /odom -->
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="libgz-sim8-odometry-publisher-system.so" name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>2</dimensions>
    </plugin>

  </model>
</sdf>
