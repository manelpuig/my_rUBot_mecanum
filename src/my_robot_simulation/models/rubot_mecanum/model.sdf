<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="rubot">

    <pose>0 0 0.10 0 0 0</pose>

    <!-- Base link -->
    <link name="base_link">
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.0104</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.0292</iyy> <iyz>0</iyz>
          <izz>0.0375</izz>
        </inertia>
      </inertial>

      <!-- Simple collision / visual for MVP -->
      <collision name="base_collision">
        <geometry>
          <box><size>0.23 0.12 0.10</size></box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box><size>0.23 0.12 0.10</size></box>
        </geometry>
      </visual>
    </link>

    <!-- Wheels (MVP: cylinders + joints) -->
    <!-- You should match your URDF joint placement: (0.07, ±0.1, 0) and (-0.085, ±0.1, 0) -->
    <link name="upper_left_wheel">
      <collision name="c"><geometry><cylinder><radius>0.055</radius><length>0.03</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.055</radius><length>0.03</length></cylinder></geometry></visual>
    </link>
    <joint name="upper_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>upper_left_wheel</child>
      <pose relative_to="base_link">0.07 0.10 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <link name="lower_left_wheel">
      <collision name="c"><geometry><cylinder><radius>0.055</radius><length>0.03</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.055</radius><length>0.03</length></cylinder></geometry></visual>
    </link>
    <joint name="lower_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>lower_left_wheel</child>
      <pose relative_to="base_link">-0.085 0.10 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <link name="upper_right_wheel">
      <collision name="c"><geometry><cylinder><radius>0.055</radius><length>0.03</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.055</radius><length>0.03</length></cylinder></geometry></visual>
    </link>
    <joint name="upper_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>upper_right_wheel</child>
      <pose relative_to="base_link">0.07 -0.10 0 0 0 0</pose>
      <axis>
        <!-- match your URDF -->
        <xyz>0 -1 0</xyz>
      </axis>
    </joint>

    <link name="lower_right_wheel">
      <collision name="c"><geometry><cylinder><radius>0.055</radius><length>0.03</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.055</radius><length>0.03</length></cylinder></geometry></visual>
    </link>
    <joint name="lower_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>lower_right_wheel</child>
      <pose relative_to="base_link">-0.085 -0.10 0 0 0 0</pose>
      <axis>
        <xyz>0 -1 0</xyz>
      </axis>
    </joint>

    <!-- Lidar link -->
    <link name="base_scan">
      <pose relative_to="base_link">0 0 0.14 0 0 0</pose>

      <sensor name="lidar" type="ray">
        <update_rate>5</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.1416</min_angle>
              <max_angle>3.1416</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>3.5</max>
            <resolution>0.015</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>

        <!-- IMPORTANT: this publishes a Gazebo topic; we'll bridge it to ROS /scan -->
        <topic>/scan</topic>
      </sensor>
    </link>
    <joint name="scan_joint" type="fixed">
      <parent>base_link</parent>
      <child>base_scan</child>
    </joint>

    <!-- Camera link -->
    <link name="camera">
      <pose relative_to="base_link">0.130 0.0 0.05 0 1.57 0</pose>

      <sensor name="camera1" type="camera">
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
        </camera>

        <!-- Gazebo topic; bridge to ROS /image_raw -->
        <topic>/image_raw</topic>
      </sensor>
    </link>
    <joint name="joint_camera" type="fixed">
      <parent>base_link</parent>
      <child>camera</child>
    </joint>

    <!-- Mecanum drive system (subscribes Twist and drives wheel joints) -->
    <plugin name="mecanum_drive" filename="gz-sim-mecanum-drive-system">
      <!-- Command topic inside Gazebo -->
      <topic>/cmd_vel</topic>

      <!-- Joint names -->
      <front_left_joint>upper_left_wheel_joint</front_left_joint>
      <front_right_joint>upper_right_wheel_joint</front_right_joint>
      <rear_left_joint>lower_left_wheel_joint</rear_left_joint>
      <rear_right_joint>lower_right_wheel_joint</rear_right_joint>

      <!-- Geometry (you must tune) -->
      <wheel_radius>0.04</wheel_radius>
      <!-- Separation / geometry parameters vary by plugin version; tune after MVP -->
      <wheel_separation_width>0.20</wheel_separation_width>
      <wheel_separation_length>0.155</wheel_separation_length>
    </plugin>

    <!-- Recommended: publish odometry (and optionally TF) -->
    <plugin name="odom_pub" filename="gz-sim-odometry-publisher-system">
      <odom_topic>/odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>2</dimensions>
    </plugin>

  </model>
</sdf>
