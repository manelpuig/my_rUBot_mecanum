<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="rubot_mecanum">
    <static>false</static>
    <pose>0 0 0 0 0 0</pose>

    <!-- =========================
         Base
         ========================= -->
    <link name="base_link">
      <pose>0 0 0.10 0 0 0</pose>

      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.10</ixx><iyy>0.10</iyy><izz>0.10</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box><size>0.35 0.25 0.10</size></box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box><size>0.35 0.25 0.10</size></box>
        </geometry>
        <material>
          <ambient>1 1 0 1</ambient>
          <diffuse>1 1 0 1</diffuse>
        </material>
      </visual>

      <!-- Opcional: si vols menys “coasting”, descomenta i prova valors petits
      <velocity_decay>
        <linear>0.2</linear>
        <angular>0.3</angular>
      </velocity_decay>
      -->

    </link>

    <!-- =========================
         Wheels (visual-only)
         ========================= -->
    <link name="upper_left_wheel">
      <pose>0.10 0.13 0.05 0 0 0</pose>
      <visual name="upper_left_wheel_visual">
        <pose>0 0 0 1.57 0 0</pose>
        <geometry>
          <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
        </geometry>
      </visual>
    </link>
    <joint name="upper_left_wheel_joint" type="fixed">
      <parent>base_link</parent>
      <child>upper_left_wheel</child>
    </joint>

    <link name="upper_right_wheel">
      <pose>0.10 -0.13 0.05 0 0 0</pose>
      <visual name="upper_right_wheel_visual">
        <pose>0 0 0 1.57 0 0</pose>
        <geometry>
          <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
        </geometry>
      </visual>
    </link>
    <joint name="upper_right_wheel_joint" type="fixed">
      <parent>base_link</parent>
      <child>upper_right_wheel</child>
    </joint>

    <link name="lower_left_wheel">
      <pose>-0.10 0.13 0.05 0 0 0</pose>
      <visual name="lower_left_wheel_visual">
        <pose>0 0 0 1.57 0 0</pose>
        <geometry>
          <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
        </geometry>
      </visual>
    </link>
    <joint name="lower_left_wheel_joint" type="fixed">
      <parent>base_link</parent>
      <child>lower_left_wheel</child>
    </joint>

    <link name="lower_right_wheel">
      <pose>-0.10 -0.13 0.05 0 0 0</pose>
      <visual name="lower_right_wheel_visual">
        <pose>0 0 0 1.57 0 0</pose>
        <geometry>
          <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
        </geometry>
      </visual>
    </link>
    <joint name="lower_right_wheel_joint" type="fixed">
      <parent>base_link</parent>
      <child>lower_right_wheel</child>
    </joint>

    <!-- =========================
         Lidar
         ========================= -->
    <link name="base_scan">
      <pose relative_to="base_link">0 0 0.14 0 0 0</pose>

      <visual name="lidar_visual">
        <geometry>
          <cylinder><radius>0.05</radius><length>0.05</length></cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/scan</topic>
        <pose>0 0 0 0 0 0</pose>

        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>
    <joint name="base_scan_joint" type="fixed">
      <parent>base_link</parent>
      <child>base_scan</child>
    </joint>

    <!-- =========================
         Camera
         ========================= -->
    <link name="camera_link">
      <pose relative_to="base_link">0.15 0 0.06 0 0 0</pose>

      <visual name="camera_visual">
        <geometry>
          <box><size>0.02 0.05 0.03</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
        </camera>
        <topic>/camera</topic>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- =========================
         Planar holonomic control
         ========================= -->
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/cmd_vel</topic>
    </plugin>

    <!-- =========================
         Odometry + TF (odom -> base_link)
         ========================= -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>

      <!-- publish odom message -->
      <odom_topic>/odom</odom_topic>

      <!-- publish odom->base_link transform as Pose_V -->
      <tf_topic>/tf</tf_topic>
    </plugin>

    <!-- =========================
         Link poses (base_link -> sensors, etc.)
         ========================= -->
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
      <static_publisher>true</static_publisher>
      <static_update_frequency>1</static_update_frequency>
    </plugin>

  </model>
</sdf>
