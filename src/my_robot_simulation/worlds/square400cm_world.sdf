<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="empty_world">
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.5 0.5 0.5 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Explicit physics configuration (ODE) for better contact / mecanum behavior -->
    <physics name="ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>

      <ode>
        <solver>
          <type>quick</type>
          <iters>80</iters>
          <sor>1.3</sor>
        </solver>

        <constraints>
          <cfm>1e-6</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <box><size>50 50 0.1</size></box>
          </geometry>

          <!-- Ground friction (helps consistency across backends / contact tuning) -->
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <box><size>50 50 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Walls: unique names -->
    <include>
      <uri>model://wall400cm</uri>
      <name>wall_pos_x</name>
      <pose>2.0 0 0.15 0 0 1.57</pose>
    </include>

    <include>
      <uri>model://wall400cm</uri>
      <name>wall_neg_x</name>
      <pose>-2.0 0 0.15 0 0 1.57</pose>
    </include>

    <include>
      <uri>model://wall400cm</uri>
      <name>wall_pos_y</name>
      <pose>0 2.0 0.15 0 0 0</pose>
    </include>

    <include>
      <uri>model://wall400cm</uri>
      <name>wall_neg_y</name>
      <pose>0 -2.0 0.15 0 0 0</pose>
    </include>

    <include>
      <uri>model://wall60cm</uri>
      <name>wall_front</name>
      <pose>1.7 0 0.15 0 0 0</pose>
    </include>

  </world>
</sdf>
